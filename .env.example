# Copia in .env (viene caricato da run.py). Tutte facoltative in demo.
APP_NAME=One Tech
APP_MODE=demo            # demo | real
PORT=5050
HOST=127.0.0.1
BASE_URL=                # URL pubblico HTTPS, es. https://xxxx.trycloudflare.com (serve per aprire il link dal telefono)
# --- modalità reale ---
SECRET_KEY=
COOKIE_SECURE=1
SMTP_HOST=               # es. smtp.gmail.com / smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=           # Gmail/Office365: password per le app
SMTP_FROM=
SMTP_TLS=1
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_TEMPLATE_LINK=
WA_TEMPLATE_OTP=
WA_TEMPLATE_LANG=it
WA_TEXT_MODE=0           # 1 = prova live senza template (il destinatario deve aver scritto al numero nelle ultime 24h)
WA_WEBHOOK_VERIFY_TOKEN=
